# Uni-rxn .gitignore setting
# Ignore all .pkl files
*.pkl

# Except xxx.pkl, which we want to track
!data/selfies_vocab.pkl
!data/react_lib_smi.pkl

# Ignore Python compiled files and directories
__pycache__/
*.py[cod]

# Ignore checkpoint files
*.ckpt

*.pt

# Large artifacts (avoid pushing >100MB to GitHub)
*.zip
*.pth

# Notebooks
.ipynb_checkpoints/

# 本地环境变量（常含密钥），只提交 .env.example
.env
.env.*
!.env.example
